# Copia este archivo como .env (junto a docker-compose.yml) y rellénalo.

# Contraseña de la base de datos. Inventa una larga y no la compartas.
POSTGRES_PASSWORD=cambia-esta-contraseña

# Carpetas en Unraid para los datos y las copias de seguridad.
DATOS=/mnt/user/appdata/somos-ekklesia
COPIAS=/mnt/user/backups/somos-ekklesia

# Puerto del servidor donde se abre la app (http://IP-del-servidor:3000).
PUERTO=3000

# Pon 1 solo para probar por http://IP-del-servidor sin HTTPS. Con Cloudflare Tunnel déjalo en 0.
COOKIE_INSEGURA=0

# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Solo para desarrollo local con `npm run dev`:
# DATABASE_URL=postgres://ekklesia:contraseña@localhost:5432/ekklesia
